# Keep the build context small and keep secrets out of the image.

.git
.claude
.gitignore
**/.env
**/.env.*

# rebuilt inside the image
**/node_modules
frontend/dist
**/*.tsbuildinfo
**/.venv
**/venv
**/__pycache__
**/*.pyc
**/.pytest_cache

# large or third-party data, mounted or fetched at run time instead
backend/data/cache
backend/data/traffic_snapshots
backend/data/cvrplib
backend/results

# not needed to run the app
docs
*.md
