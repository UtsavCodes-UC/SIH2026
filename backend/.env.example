# Copy this file to backend/.env and fill it in. .env is git-ignored: never commit a real key.

# TomTom Traffic API key (https://developer.tomtom.com -> Keys -> Create key).
# Enable "Traffic API" and "Traffic Flow API" on the key and leave domain whitelisting OFF:
# the backend calls TomTom server-to-server, which sends no browser Referer header.
TOMTOM_API_KEY=

# Optional tuning (defaults shown)
# LIVE_TRAFFIC_SAMPLES=80              # road points queried per refresh (free tier: 2,500 requests/day)
# LIVE_TRAFFIC_MIN_INTERVAL_SEC=300    # reuse the last reading this long instead of querying again
# TOMTOM_MAX_QPS=5                     # requests per second sent to TomTom
# TOMTOM_FLOW_ZOOM=15                  # higher zoom = smaller roads are included
# PLACE_SEARCH_URL=https://photon.komoot.io/api/   # place-name suggestions; your own Photon, or `off` to disable
